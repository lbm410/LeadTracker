# =============================================================================
# LeadTracker Pro — environment configuration
# Copy this file to ".env" (cp .env.example .env) and adjust as needed.
# Sensible defaults are baked into docker-compose, so the app runs as-is.
# =============================================================================

# --- Database ---
POSTGRES_USER=leadtracker
POSTGRES_PASSWORD=leadtracker
POSTGRES_DB=leadtracker
# Host port for Postgres (change if 5432 is taken on your machine).
DB_PORT=5432

# --- API ---
# Simple single-user protection. Change this to your own secret.
# Leave empty to disable the check entirely (not recommended).
API_KEY=dev-local-key-change-me
# Host port for the API.
API_PORT=8000
# Comma-separated list of allowed CORS origins (the web app).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# A lead is "cold" after this many days without any interaction.
COLD_LEAD_DAYS=7

# --- Web ---
# Host port for the React app.
WEB_PORT=5173
# Where the browser should reach the API. Must match API_PORT above.
VITE_API_URL=http://localhost:8000
